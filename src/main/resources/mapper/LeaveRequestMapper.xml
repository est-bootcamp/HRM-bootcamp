        <result property="appEmpId" column="app_emp_id"/>
        <result property="rqsEmpId" column="rqs_emp_id"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="status" column="status"/>
        <result property="requestDate" column="request_date"/>
        <result property="regIp" column="reg_ip"/>
        <result property="regDate" column="reg_date"/>
        <result property="regUsId" column="reg_us_id"/>
        <result property="modIp" column="mod_ip"/>
        <result property="modDate" column="mod_date"/>
        <result property="modUsId" column="mod_us_id"/>
        <result property="useYn" column="use_yn"/>
        <result property="note" column="note"/>
    </resultMap>

    <!-- 단건 조회 -->
    <select id="findById" parameterType="long" resultMap="LeaveRequestMap">
        SELECT * FROM LV_RQ WHERE lv_id = #{lvId}
    </select>

    <!-- 전체 조회 -->
    <select id="findAll" resultMap="LeaveRequestMap">
        SELECT * FROM LV_RQ
    </select>

    <!-- 등록 -->
    <insert id="insert" parameterType="com.example.est_bootcamp.leave.LeaveRequest">
        INSERT INTO LV_RQ (
        lv_id, lv_ty, app_emp_id, rqs_emp_id,
        start_date, end_date, status, request_date,
        reg_ip, reg_date, reg_us_id, mod_ip, mod_date, mod_us_id,
        use_yn, note
        ) VALUES (
        #{lvId}, #{lvTy}, #{appEmpId}, #{rqsEmpId},
        #{startDate}, #{endDate}, #{status}, #{requestDate},
        #{regIp}, #{regDate}, #{regUsId}, #{modIp}, #{modDate}, #{modUsId},
        #{useYn}, #{note}
        )
    </insert>

    <!-- 수정 -->
    <update id="update" parameterType="com.example.est_bootcamp.leave.LeaveRequest">
        UPDATE LV_RQ
        SET lv_ty = #{lvTy},
        app_emp_id = #{appEmpId},
        rqs_emp_id = #{rqsEmpId},
        start_date = #{startDate},
        end_date = #{endDate},
        status = #{status},
        request_date = #{requestDate},
        reg_ip = #{regIp},
        reg_d_
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM LV_RQ WHERE lv_id = #{lvId}
    </delete>

</mapper>