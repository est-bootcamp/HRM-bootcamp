<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.est_bootcamp.repo.UserAccountMapper">

    <resultMap id="UserAccountMap" type="com.example.est_bootcamp.user.UserAccount">
        <id property="usNo" column="us_no"/>
        <result property="loginId" column="login_id"/>
        <result property="password" column="password"/>
        <result property="regIp" column="reg_ip"/>
        <result property="regDate" column="reg_date"/>
        <result property="regUsId" column="reg_us_id"/>
        <result property="modIp" column="mod_ip"/>
        <result property="modDate" column="mod_date"/>
        <result property="modUsId" column="mod_us_id"/>
        <result property="useYn" column="use_yn"/>
        <result property="note" column="note"/>
        <result property="usRole" column="us_role"/>
    </resultMap>

    <!-- 단건 조회: loginId -->
    <select id="findByLoginId" parameterType="string" resultMap="UserAccountMap">
        SELECT * FROM US WHERE login_id = #{loginId}
    </select>

    <!-- 단건 조회: PK -->
    <select id="findById" parameterType="long" resultMap="UserAccountMap">
        SELECT * FROM US WHERE us_no = #{usNo}
    </select>

    <!-- 등록 -->
    <insert id="insert" parameterType="com.example.est_bootcamp.user.UserAccount"
            useGeneratedKeys="true" keyProperty="usNo">
        INSERT INTO US (
        login_id, password, reg_ip, reg_date, reg_us_id,
        mod_ip, mod_date, mod_us_id, use_yn, note, us_role
        )
        VALUES (
        #{loginId}, #{password}, #{regIp}, #{regDate}, #{regUsId},
        #{modIp}, #{modDate}, #{modUsId}, #{useYn}, #{note}, #{usRole}
        )
    </insert>

    <!-- 수정 -->
    <update id="update" parameterType="com.example.est_bootcamp.user.UserAccount">
        UPDATE US
        SET login_id = #{loginId},
        password = #{password},
        reg_ip = #{regIp},
        reg_date = #{regDate},
        reg_us_id = #{regUsId},
        mod_ip = #{modIp},
        mod_date = #{modDate},
        mod_us_id = #{modUsId},
        use_yn = #{useYn},
        note = #{note},
        us_role = #{usRole}
        WHERE us_no = #{usNo}
    </update>

    <!-- 삭제 -->
    <delete id="delete" parameterType="long">
        DELETE FROM US WHERE us_no = #{usNo}
    </delete>

</mapper>
